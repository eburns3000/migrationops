# MigrationOps Frontend — Environment Configuration
# Copy to .env (local dev) or .env.production (build for S3 deployment)

# ─── API Base URL ─────────────────────────────────────────────────────────────
# Local dev: leave empty — Vite proxy in vite.config.ts routes /api → localhost:3001
# SAM local: VITE_API_BASE_URL=http://localhost:3002
# AWS deployment: VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=

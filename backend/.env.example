# MigrationOps Backend — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Storage Backend ─────────────────────────────────────────────────────────
# memory    → in-memory store, seeded RetailCo data (default, no infra needed)
# dynamodb  → DynamoDB (set DYNAMODB_ENDPOINT for local, or real AWS)
STORAGE_BACKEND=memory

# ─── DynamoDB (when STORAGE_BACKEND=dynamodb) ────────────────────────────────
# For DynamoDB Local: docker run -p 8000:8000 amazon/dynamodb-local
# Then run: npm run seed:dynamo
# DYNAMODB_ENDPOINT=http://localhost:8000

# Table names (set automatically by SAM template on AWS deployment)
# DYNAMODB_WORKLOADS_TABLE=migrationops-workloads
# DYNAMODB_ASSESSMENTS_TABLE=migrationops-assessments
# DYNAMODB_REPORTS_TABLE=migrationops-reports

# ─── AI Provider ─────────────────────────────────────────────────────────────
# The reasoning layer is model-agnostic and can support Bedrock or third-party
# LLM APIs depending on governance and cost requirements.
AI_PROVIDER=anthropic

# Anthropic (default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Amazon Bedrock (swap for AWS deployment — change AI_PROVIDER=bedrock)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Development: allow Vite dev server
CORS_ORIGIN=http://localhost:5173
# Production: restrict to CloudFront domain
# CORS_ORIGIN=https://your-cloudfront-domain.cloudfront.net

# ─── AWS (for SAM local / DynamoDB Local dev) ────────────────────────────────
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are read from your AWS profile
# or set explicitly for DynamoDB Local (any values work for local)
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
